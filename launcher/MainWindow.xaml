<Window x:Class="WarbornLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Warborn Kingdoms · Europe1100" Width="1280" Height="760" MinWidth="1000" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#101A13" Foreground="#EEECE2" FontFamily="Segoe UI" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Grid>
  <Image Source="Assets/europe1100-knight.png" Stretch="UniformToFill" Opacity="0.8"/>
  <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F10D170F" Offset="0"/><GradientStop Color="#D5101A12" Offset="0.46"/><GradientStop Color="#89101A12" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Grid Margin="30,18,30,24">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="8" Height="8" CornerRadius="4" Background="#A7BC82" Margin="0,0,10,0"/><TextBlock Text="WARBORN KINGDOMS" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="  /  EUROPE1100" FontSize="10" Foreground="#AAB59F" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Tag="settings" Click="SettingsClick" Padding="14,8" Margin="0,0,14,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button Content="—" Width="34" Padding="0" Margin="0,0,5,0" Click="MinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize"/>
     <Button Content="□" Width="34" Padding="0" Margin="0,0,5,0" Click="MaximizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize"/>
     <Button Content="×" Width="34" Padding="0" Click="CloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Exit"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="18,0,18,0">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="690">
     <TextBlock Tag="campaignLabel" FontSize="10" Foreground="#D1BA81"/>
     <TextBlock Text="Warborn" FontSize="66" FontWeight="Light" Margin="-4,10,0,0"/>
     <TextBlock Text="Kingdoms." FontSize="66" FontWeight="Light" Foreground="#D1BA81" Margin="-4,-6,0,16"/>
     <Border Width="70" Height="2" Background="#D1BA81" HorizontalAlignment="Left" Margin="0,0,0,18"/>
     <TextBlock Tag="campaignLine" FontSize="13" Foreground="#D3DCCB" TextWrapping="Wrap"/>
     <Button Content="Discord  ↗" Click="DiscordClick" Padding="17,10" HorizontalAlignment="Left" Margin="0,24,0,0"/>
    </StackPanel>
    <Border x:Name="SettingsPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Width="440" Padding="24" CornerRadius="14" Background="#F1121E17" BorderBrush="#7C8C6D" BorderThickness="1">
     <StackPanel>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Tag="settingsTitle" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Content="×" Click="SettingsCloseClick" Padding="8,5"/></Grid>
      <TextBlock Tag="language" FontSize="10" Foreground="#D1BA81" Margin="0,0,0,7"/>
      <ComboBox x:Name="LanguagePicker" SelectionChanged="LanguageChanged" Margin="0,0,0,18" shell:WindowChrome.IsHitTestVisibleInChrome="True"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="Русский" Tag="ru"/></ComboBox>
      <TextBlock Tag="installTitle" FontSize="10" Foreground="#D1BA81" Margin="0,0,0,7"/>
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PathLabel" FontSize="10" Foreground="#D8DECE" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,10,0"/><Button Grid.Column="1" Tag="folder" Click="FolderClick" Padding="11,8"/></Grid>
      <TextBlock x:Name="StatusLabel" FontSize="10" Foreground="#C6D1BD" TextWrapping="Wrap" Margin="0,0,0,15"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="check" Click="RefreshClick" Padding="12,9" Margin="0,0,8,0"/><Button Tag="apply" Click="ApplyLanguageClick" Padding="12,9"/></StackPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Row="2" Background="#ED111E14" BorderBrush="#67809462" BorderThickness="1" CornerRadius="13" Padding="17,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Tag="profileLabel" Foreground="#D1BA81" FontSize="9"/><TextBlock x:Name="BottomStatusLabel" FontSize="10" Foreground="#AEBBA5" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateButton" Tag="updateAction" Click="UpdateClick" Padding="18,13" Margin="0,0,8,0"/><Button x:Name="StartButton" Tag="startAction" Click="PlayClick" Padding="21,13" Background="#BCD18C" Foreground="#112015" BorderBrush="#BCD18C" ToolTip="Start Bannerlord; join Warborn from the game menu"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
